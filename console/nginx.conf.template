# Lock Admin — loopback-only demo edge (OpenResty).
#
# SECURITY POSTURE
# ----------------
# This server fronts an API that can BREAK ADVISORY LOCKS. It must never be
# reachable from a routable interface. This template:
#   * binds to 127.0.0.1 only
#   * requires HTTP basic auth (a seatbelt, not a door)
#   * serves plain HTTP, which is ONLY acceptable on loopback
# A real deployment terminates TLS with client certificates (mTLS) here, or
# moves this API onto a unix socket / dedicated admin port. Do not ship this
# configuration beyond localhost.
#
# Rendered by tooling/lib/consolectl.tl — do not hand-edit the tmp/ output.

pid @TMP@/nginx.pid;
error_log @TMP@/nginx-error.log warn;
worker_processes 1;

events {
  worker_connections 128;
}

http {
  access_log @TMP@/nginx-access.log;
  client_body_temp_path @TMP@/nginx-body;
  proxy_temp_path @TMP@/nginx-proxy;
  fastcgi_temp_path @TMP@/nginx-fastcgi;
  uwsgi_temp_path @TMP@/nginx-uwsgi;
  scgi_temp_path @TMP@/nginx-scgi;

  lua_shared_dict lockadmin 1m;
  lua_package_path "@ROOT@/openresty/lualib/?.lua;;";

  # Handler setup happens once here (init_by_lua runs in the master before
  # fork; workers inherit the globals). content_by_lua_block is per-request
  # and must NOT redo setup. State is per-worker, which is fine for the
  # console: the shared dict carries cross-worker counters/gauges.
  init_by_lua_block {
    local handlers = require("handlers")

    console_config = {
      cluster_json_path = "@TMP@/cluster.json",
      telemetry_base = "@TMP@/telemetry",
      workload = "@WORKLOAD@" == "on",
    }

    -- telemetry_dirs_by_node: node name → segment dir, derived from
    -- cluster.json so the template stays topology-agnostic.
    local dirs = {}
    local fh = io.open(console_config.cluster_json_path, "rb")
    if fh then
      local text = fh:read("*a")
      fh:close()
      for name in text:gmatch('"name"%s*:%s*"([^"]+)"') do
        dirs[name] = console_config.telemetry_base .. "/" .. name
      end
    end

    console_state = handlers.setup({
      cluster_json_path = console_config.cluster_json_path,
      telemetry_dirs_by_node = dirs,
      dict = ngx.shared.lockadmin,
      now_ms = function() return math.floor(ngx.now() * 1000) end,
      break_exec = handlers.ngx_break_exec(),
    })
    console_api = handlers.ngx_handler(console_state)
  }

  init_worker_by_lua_block {
    if console_config.workload then
      require("workload").start({
        enabled = true,
        cluster_path = console_config.cluster_json_path,
        dict = ngx.shared.lockadmin,
      })
    end
  }

  types {
    text/html html;
    text/css css;
    text/javascript js mjs;
    application/json json map;
    image/svg+xml svg;
    font/woff2 woff2;
  }
  default_type application/octet-stream;

  server {
    listen 127.0.0.1:@PORT@;

    auth_basic "lock-admin loopback demo (needs TLS+mTLS off-loopback)";
    auth_basic_user_file @TMP@/htpasswd;

    root @ASSETS@;
    index index.html;

    add_header X-Lock-Admin-Warning "loopback demo only; TLS+mTLS required off-loopback" always;
    # Scripts may come only from this origin or the SRI-pinned CDN; styles need
    # 'unsafe-inline' because the SPA sets inline style attributes.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; connect-src 'self'; img-src 'self' data:" always;

    location / {
      try_files $uri $uri/ /index.html;
    }

    location /api/v1/ {
      content_by_lua_block {
        console_api()
      }
    }
  }
}
