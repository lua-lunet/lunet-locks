// The negative gate's config: the same compiler options as the real gate,
// pointed at the one fixture that must NOT type-check (tsconfig.json's
// include would sweep it into the main gate, so the fixture lives under
// tooling/ and only this config reads it).
{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["tooling/mjs-gate-fixture/*.mjs"]
}
